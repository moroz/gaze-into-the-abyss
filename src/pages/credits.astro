---
import { getCollection } from "astro:content"
import { byPosition } from "../scripts/by-position"
import { mediaUrl } from "../scripts/media"
import { sentence } from "../scripts/sentence"
import { Image } from "astro:assets"
import Base from "../layouts/Base.astro"

const backgrounds = (await getCollection("backgrounds")).sort(byPosition)
const tracks = (await getCollection("music")).sort(byPosition)
---

<Base title="Credits · Gaze into the Abyss" description="Where the imagery and music in Gaze into the Abyss come from.">
  <main class="credits">
    <h1>Credits</h1>
    <p><a href="/">Back into the abyss</a></p>

    <h2>Imagery</h2>
    <p>
      Public domain or Creative Commons. The videos are excerpts looped with a crossfade; a share-alike original makes
      its loop share-alike under the same licence.
    </p>
    <ul class="images">
      {backgrounds.map(({ data }) => (
        <li>
          {data.video
            ? <video src={`${mediaUrl(data.video.h264)}#t=1`} muted playsinline preload="metadata" aria-hidden="true"></video>
            : <Image src={data.image!} alt="" width={160} height={100} fit="cover" format="webp" />}
          <div>
            <a href={data.sourceUrl}>{data.title}</a>
            <span>{sentence(data.author)} {data.licenceUrl ? <a href={data.licenceUrl}>{data.licence}</a> : data.licence}.{data.video && data.licence.includes("BY-SA") && " This loop is shared under the same licence."}</span>
          </div>
        </li>
      ))}
    </ul>

    <h2>Music</h2>
    <p>
      The recordings below are slowed, keeping their pitch; the MIDI editions are played on the orchestral instruments
      they name using FluidSynth and the FluidR3 GM soundfont by Frank Wen (MIT licence). Every track is then saturated
      and given a long reverb.
    </p>
    <ul class="tracks">
      {tracks.map(({ data }) => (
        <li>
          <strong>{data.title}</strong>
          <span>{data.composer}, {data.work}. {data.arrangement}</span>
          <span>From the <a href={data.editionUrl}>{data.edition}</a>.</span>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .credits { box-sizing: border-box; max-width: 760px; margin: 0 auto; padding: 48px 16px 64px; line-height: 1.5; }
  h1 { margin: 0 0 8px; font-size: 32px; }
  h2 { margin: 40px 0 8px; font-size: 20px; }
  ul { margin: 16px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 16px; }
  li { display: flex; gap: 16px; align-items: center; }
  .tracks li { flex-direction: column; align-items: flex-start; gap: 2px; }
  li div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  li span { color: #9fb0c4; font-size: 14px; overflow-wrap: anywhere; }
  img, video { flex: none; width: 120px; height: 75px; object-fit: cover; border-radius: 6px; }

  @media (max-width: 480px) {
    .images li { flex-direction: column; align-items: flex-start; }
  }
</style>
