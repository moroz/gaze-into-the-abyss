<canvas class="trip" aria-hidden="true"></canvas>
<div class="vignette" aria-hidden="true"></div>

<script>
  import fragment from "../scripts/psychedelia.frag?raw"
  import { runShader } from "../scripts/shader-canvas"

  runShader(document.querySelector<HTMLCanvasElement>(".trip")!, fragment)
</script>

<style>
  .trip { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; mix-blend-mode: screen; opacity: .9; animation: breathe 50s ease-in-out infinite alternate; }
  .vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, #000000b3 100%); }

  @keyframes breathe { from { opacity: .75; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .trip { animation: none; }
  }
</style>
