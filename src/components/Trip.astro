<canvas class="trip" aria-hidden="true"></canvas>
<div class="vignette" aria-hidden="true"></div>

<script>
  import fragment from "../scripts/psychedelia.frag?raw"
  import { runShader } from "../scripts/shader-canvas"
  import { SCENES, sceneSchedule } from "../scripts/scene-schedule"
  import { randomStream } from "../scripts/random"

  const canvas = document.querySelector<HTMLCanvasElement>(".trip")!
  const chosen = SCENES.indexOf(new URLSearchParams(location.hash.slice(1)).get("scene") as (typeof SCENES)[number])
  canvas.style.animationDelay = `-${randomStream("overlay").next() * 100}s`
  runShader(canvas, fragment, sceneSchedule(chosen >= 0 ? chosen : undefined))
</script>

<style>
  .trip { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; mix-blend-mode: screen; opacity: .75; animation: breathe 50s ease-in-out infinite alternate; }
  .vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, #000000b3 100%); }

  @keyframes breathe { from { opacity: .45; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .trip { animation: none; }
  }
</style>
