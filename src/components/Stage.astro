---
// The whole picture, drawn in one WebGL 2 canvas by scripts/stage.ts: backgrounds, trip overlay, vignette and dawn.
import { getCollection } from "astro:content"
import { byPosition } from "../scripts/by-position"
import { mediaUrl } from "../scripts/media"
import type { SlideData } from "../scripts/slideshow"

const entries = (await getCollection("backgrounds")).sort(byPosition)
const slides: SlideData[] = entries.map(({ data }) => {
  const credit = { title: data.title, author: data.author, licence: data.licence, licenceUrl: data.licenceUrl, sourceUrl: data.sourceUrl }
  const overlay = data.overlay ?? (data.video ? "calm" : "psychedelic")
  if (data.video) return { kind: "video", overlay, credit, subject: data.subject, effects: data.effects, distortion: data.distortion ?? 1, av1: mediaUrl(data.video.av1), h264: mediaUrl(data.video.h264) }
  const widths = [...data.image!.widths].sort((a, b) => a.width - b.width).map(({ width, path }) => ({ width, url: mediaUrl(path) }))
  return { kind: "image", overlay, credit, subject: data.subject, distortion: 1, widths }
})

// Without WebGL 2 the page shows the first image, still.
const still = entries.find(({ data }) => data.image)!.data
const stillWidths = still.image!.widths
const stillSrc = mediaUrl((stillWidths.findLast(({ width }) => width <= 1920) ?? stillWidths[0]).path)
const stillSrcset = stillWidths.map(({ width, path }) => `${mediaUrl(path)} ${width}w`).join(", ")
const stillCredit = { title: still.title, author: still.author, licence: still.licence, licenceUrl: still.licenceUrl, sourceUrl: still.sourceUrl }
---

<div class="footage" aria-hidden="true"></div>
<canvas class="stage" aria-hidden="true"></canvas>
<img class="still" hidden src={stillSrc} srcset={stillSrcset} sizes="100vw" alt="" decoding="async" data-credit={JSON.stringify(stillCredit)} />
<script type="application/json" id="slides" set:html={JSON.stringify(slides)} />

<script>
  import fragment from "../scripts/psychedelia.frag?raw"
  import { runStage } from "../scripts/stage"

  const canvas = document.querySelector<HTMLCanvasElement>(".stage")!
  const slides = JSON.parse(document.getElementById("slides")!.textContent!)
  const started = runStage({ canvas, pool: document.querySelector<HTMLElement>(".footage")!, slides, fragment })
  if (!started) {
    canvas.remove()
    const still = document.querySelector<HTMLImageElement>(".still")!
    still.hidden = false
    document.dispatchEvent(new CustomEvent("abyss:background", { detail: JSON.parse(still.dataset.credit!) }))
    document.dispatchEvent(new Event("abyss:first-image"))
    document.documentElement.dataset.firstImage = "shown"
  }
</script>

<style>
  .stage, .still, .footage { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage { z-index: 1; }
  .still { object-fit: cover; filter: brightness(.8) saturate(1.3) contrast(1.05); }
  /* The videos the stage reads frames from, full size and composited under the opaque canvas, as they used to be
     under their warp canvases: a browser can starve a video it is not drawing (tiny or transparent) of fresh
     frames, or stop decoding it. */
  .footage { pointer-events: none; }
  .footage :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
